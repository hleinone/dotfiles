alias l='ls -laFh'
alias la='ls -lAfh'
alias ll='ls -l'

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

alias ..='cd ..'

alias icat='kitty +kitten icat'
alias d='kitty +kitten diff'

